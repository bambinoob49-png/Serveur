<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Infos PC</title>
  <style>
    body {
      font-family: Arial, sans-serif;
      background: #111827;
      color: #f3f4f6;
      margin: 0;
      padding: 20px;
    }
    .box {
      max-width: 900px;
      margin: auto;
      background: #1f2937;
      padding: 20px;
      border-radius: 12px;
      box-shadow: 0 0 15px rgba(0,0,0,0.3);
    }
    h1 {
      margin-top: 0;
      font-size: 24px;
    }
    pre {
      white-space: pre-wrap;
      word-break: break-word;
      background: #0f172a;
      padding: 15px;
      border-radius: 8px;
      overflow: auto;
    }
  </style>
</head>
<body>
  <div class="box">
    <h1>Informations du navigateur / appareil</h1>
    <p>En cliquant ci-dessous, tu acceptes que ces informations soient envoyées à un serveur de test.</p>
    <pre id="infos">Chargement...</pre>
  </div>

  <script>
    const infos = document.getElementById('infos');
    const OWNER_ENDPOINT = 'https://VOTRE-APP.onrender.com/collect';

    async function sendDataToOwner(data) {
      try {
        const response = await fetch(OWNER_ENDPOINT, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json'
          },
          body: JSON.stringify({
            timestamp: new Date().toISOString(),
            data
          })
        });

        const result = await response.json().catch(() => ({}));
        infos.textContent += '\n\nStatut envoi: ' + JSON.stringify({ ok: response.ok, result }, null, 2);
      } catch (error) {
        infos.textContent += '\n\nÉchec de l’envoi des données au serveur local: ' + error.message;
        console.error('Échec de l’envoi des données au propriétaire:', error);
      }
    }

    async function getPublicIp() {
      try {
        const response = await fetch('https://api.ipify.org?format=json');
        const data = await response.json();
        return data.ip || 'Inconnu';
      } catch {
        return 'Impossible à récupérer';
      }
    }

    async function getLocationData() {
      try {
        const response = await fetch('https://ipapi.co/json/');        
        return await response.json();
      } catch {
        return null;
      }
    }

    function getBrowserInfo() {
      const nav = navigator;
      return {
        navigateur: nav.userAgent,
        plateforme: nav.platform,
        langue: nav.language,
        langues: nav.languages,
        cookies: nav.cookieEnabled,
        online: nav.onLine,
        java: nav.javaEnabled ? nav.javaEnabled() : 'Inconnu',
        hardwareConcurrency: nav.hardwareConcurrency || 'Inconnu',
        deviceMemory: nav.deviceMemory || 'Inconnu',
        appCodeName: nav.appCodeName,
        appName: nav.appName,
        appVersion: nav.appVersion,
        vendor: nav.vendor,
        product: nav.product,
        timezone: Intl.DateTimeFormat().resolvedOptions().timeZone,
        screen: {
          width: screen.width,
          height: screen.height,
          colorDepth: screen.colorDepth,
          pixelDepth: screen.pixelDepth,
          orientation: screen.orientation ? screen.orientation.type : 'Inconnu'
        },
        windows: {
          innerWidth: window.innerWidth,
          innerHeight: window.innerHeight,
          outerWidth: window.outerWidth,
          outerHeight: window.outerHeight
        },
        date: new Date().toString()
      };
    }

    async function main() {
      const ip = await getPublicIp();
      const loc = await getLocationData();

      const data = {
        ipPublic: ip,
        localisation: loc ? {
          ville: loc.city || 'Inconnu',
          region: loc.region || 'Inconnu',
          pays: loc.country_name || 'Inconnu',
          codePays: loc.country_code || 'Inconnu',
          latitude: loc.latitude || 'Inconnu',
          longitude: loc.longitude || 'Inconnu',
          fuseauHoraire: loc.timezone || 'Inconnu',
          org: loc.org || 'Inconnu'
        } : 'Impossible à récupérer la localisation',
        infosNavigateur: getBrowserInfo()
      };

      infos.textContent = JSON.stringify(data, null, 2);
      await sendDataToOwner(data);
    }

    main();
  </script>
</body>
</html>
